# Copy to .env and fill in values. Never commit .env.

# MySQL — same database as the PHP app. Do NOT run Prisma migrations against it.
# If MySQL is only on the server, use an SSH tunnel, e.g. local port 3307:
#   ssh -L 3307:127.0.0.1:3306 user@your-host
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3307/DATABASE_NAME"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Storage (local disk now; swap driver for S3 later).
# Point at the PHP app's uploads folder so existing resumes resolve:
#   UPLOAD_ROOT="../uploads"   (when running from web/)
UPLOAD_ROOT="../uploads"
MAX_UPLOAD_BYTES="5242880"

SITE_NAME="Concept Kart Careers"
